[Unit]
Description=Srz AutoFlow autonomous scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=srz-autoflow
Group=srz-autoflow
WorkingDirectory=/opt/srz-autoflow
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/srz-autoflow/.venv/bin/python -m app.services.scheduler
Restart=always
RestartSec=10
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
