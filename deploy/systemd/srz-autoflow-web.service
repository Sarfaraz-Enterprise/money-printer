[Unit]
Description=Srz AutoFlow Streamlit dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=srz-autoflow
Group=srz-autoflow
WorkingDirectory=/opt/srz-autoflow
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/srz-autoflow/.venv/bin/python -m streamlit run webui.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
